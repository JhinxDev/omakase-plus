# Copy to .env when deploying via docker compose, fill in real values.

# ── Public demo ──────────────────────────────────────────────────────

# Required: an API key for one of the supported cloud LLM backends.
# Common picks for a public demo (free tiers):
#   Gemini Flash  → https://aistudio.google.com/apikey
#   Groq          → https://console.groq.com/keys
OMAKASE_API_KEY=

# Optional: MyAnimeList Client ID (only if exposing MAL as a source).
# Get one at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=

# ── Plus mode (private, workstation-only) ────────────────────────────

# Set to "true" to enable Plus routes (/plus/*). Default: false (public mode).
OMAKASE_PLUS_PRIVATE=false
OMAKASE_PLUS_URL=
OMAKASE_ALLOWED_HOSTS=localhost,127.0.0.1
OMAKASE_SESSION_COOKIE_SECURE=false
# Production rejects user-selected LLM URLs that resolve to local/private
# addresses. Set true only on a trusted self-host where local models are wanted.
OMAKASE_ALLOW_PRIVATE_LLM_URLS=false

# 32-byte hex key for encrypting stored secrets (AES-256-GCM).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
OMAKASE_PLUS_MASTER_KEY=

# Exact private source revision and the dedicated CT111 manifest/receipt credential.
OMAKASE_REVISION=
OMAKASE_LIBRARY_MANIFEST_TOKEN=

# Seed account credentials (used by `python -m omakase.plus.admin seed-user`).
OMAKASE_SEED_EMAIL=
OMAKASE_SEED_PASSWORD=

# AniList OAuth app — register at https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Server-wide safety gate for signed Apple TV watch observations. Leave false
# until Home Assistant exposes stable series, season, episode, and position data
# for the target app and the signed bridge has passed a dry run.
OMAKASE_PLUS_APPLE_TV_WATCH_ENABLED=false

# Overseerr instance (from Overseerr Settings → API).
OVERSEERR_URL=http://overseerr.lab:5055
OVERSEERR_API_KEY=

# Admin token for Plus admin CLI operations.
OMAKASE_PLUS_ADMIN_TOKEN=
