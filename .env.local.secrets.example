# Copy to .env.local.secrets and restrict it to the deployment owner (0600).
# Never commit, paste into support bundles, or pass these values as CLI args.

OMAKASE_PLUS_MASTER_KEY=
OMAKASE_LIBRARY_MANIFEST_TOKEN=
OMAKASE_SEED_EMAIL=
OMAKASE_SEED_PASSWORD=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
OMAKASE_PLEX_TOKEN=
PLEX_CLAIM=
OMAKASE_QBITTORRENT_USERNAME=
OMAKASE_QBITTORRENT_PASSWORD=

# Gluetun reads the provider/custom tunnel values directly. Omakase contains no
# commercial VPN-provider-specific code. Fill only the variables your selected
# Gluetun mode requires.
OPENVPN_USER=
OPENVPN_PASSWORD=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
