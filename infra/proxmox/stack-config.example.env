# Omakase Stack Proxmox plan input.
# Values are parsed as data, never sourced as shell code.

LAYOUT=compact
OMAKASE_CTID=120
OMAKASE_HOSTNAME=omakase-stack
OMAKASE_IP=dhcp
GATEWAY=
BRIDGE=vmbr0
ROOTFS_STORAGE=local-lvm
TEMPLATE_STORAGE=local
DEBIAN_TEMPLATE=
CORES=4
MEMORY_MB=4096
SWAP_MB=512
ROOTFS_GB=32
STARTUP_ORDER=6
TIMEZONE=host
SSH_PUBLIC_KEY_FILE=/root/.ssh/omakase-stack.pub

# Optional host path. Proxmox recommends a dedicated path below
# /mnt/bindmounts; never use /, /var, /etc, or a symlink.
MEDIA_MOUNT_SOURCE=
MEDIA_MOUNT_TARGET=/srv/omakase

# Import-only is the safe default. This only passes /dev/net/tun through to the
# LXC; qBittorrent still remains disabled until its explicit Compose profile is
# configured and started.
ENABLE_VPN=false

# Optional exact release archive already present on the Proxmox host. Supplying
# an archive requires its SHA-256 and only stages source; it never starts the
# application before secrets and the rendered Compose plan are reviewed.
SOURCE_ARCHIVE=
SOURCE_SHA256=
