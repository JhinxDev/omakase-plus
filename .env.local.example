# Copy to .env.local. This file contains non-secret deployment choices only.
# Keep credentials in .env.local.secrets (mode 0600); see the separate example.

COMPOSE_PROJECT_NAME=omakase-local
OMAKASE_REVISION=local-dev
OMAKASE_BIND_ADDRESS=127.0.0.1
OMAKASE_PORT=8766
OMAKASE_PLUS_URL=http://127.0.0.1:8766
OMAKASE_ALLOWED_HOSTS=localhost,127.0.0.1
OMAKASE_SESSION_COOKIE_SECURE=false
OMAKASE_ALLOW_PRIVATE_LLM_URLS=false
OMAKASE_ALLOW_PRIVATE_CATALOG_URLS=false
OMAKASE_PUID=1000
OMAKASE_PGID=1000
OMAKASE_DATA_PATH=./data/omakase
OMAKASE_IMPORT_PATH=./data/import
OMAKASE_LIBRARY_PATH=./data/library
OMAKASE_ACQUISITION_MODE=import-only
OMAKASE_VPN_MODE=none
OMAKASE_PLEX_URL=http://host.docker.internal:32400
TZ=Etc/UTC

# Optional expanded source-search profile. Set the private-catalog flag to true
# only when this trusted local Prowlarr service is enabled.
PROWLARR_BIND_ADDRESS=127.0.0.1
PROWLARR_PORT=9696
PROWLARR_CONFIG_PATH=./data/prowlarr
PROWLARR_PUID=1000
PROWLARR_PGID=1000

# Optional bundled Plex profile.
PLEX_IMAGE_TAG=1.43.2.10687-563d026ea
PLEX_BIND_ADDRESS=127.0.0.1
PLEX_HOSTNAME=omakase-plex
PLEX_ADVERTISE_IP=http://127.0.0.1:32400/
PLEX_CONFIG_PATH=./data/plex
PLEX_TRANSCODE_PATH=./data/transcode
PLEX_PUID=1000
PLEX_PGID=1000

# Optional qBittorrent + provider-neutral Gluetun profile.
QBITTORRENT_IMAGE_TAG=5.2.3-1
QBITTORRENT_BIND_ADDRESS=127.0.0.1
QBITTORRENT_CONFIG_PATH=./data/qbittorrent
QBITTORRENT_PUID=1000
QBITTORRENT_PGID=1000
QBT_WEBUI_PORT=8080
QBT_TORRENTING_PORT=6881
QBT_LEGAL_NOTICE=
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
GLUETUN_CONFIG_PATH=./data/gluetun

# Omakase's scoped qBittorrent API contract.
OMAKASE_QBITTORRENT_URL=http://gluetun:8080
OMAKASE_QBITTORRENT_CATEGORY=omakase
