# Normalize line endings on commit; check out with platform-native endings
# disabled for binaries and lockfiles.
* text=auto eol=lf

# Explicit text files (belt-and-suspenders against editors that strip BOMs etc.)
*.py     text eol=lf diff=python
*.pyi    text eol=lf diff=python
*.toml   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.sh     text eol=lf
Dockerfile text eol=lf

# Windows-only files (if any are ever added)
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binaries — never touch
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.whl    binary
